{
  "name": "zidan-select",
  "version": "2.2.4",
  "description": "Zero-dependency form enhancement library: select/combobox/tags, checkboxes, switches, radio groups, drag & drop file upload with progress, text/number/phone/date/range inputs and textarea with input icons and steppers. Split core/theme CSS, 5 themes, 11 layouts, framework adapters. Load only the select-only or file-only build if that is all you need, or the full form bundle to enhance every input at once.",
  "keywords": [
    "select",
    "combobox",
    "tags",
    "checkbox",
    "switch",
    "radio",
    "file-upload",
    "form",
    "form-validation",
    "phone-input",
    "range-slider",
    "vanilla-js",
    "zero-dependency",
    "accessible",
    "theming",
    "bootstrap",
    "tailwind"
  ],
  "license": "MIT",
  "author": {
    "name": "akhtar1985",
    "url": "https://github.com/akhtar1985"
  },
  "homepage": "https://akhtar1985.github.io/zidan-select/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhtar1985/zidan-select.git"
  },
  "bugs": {
    "url": "https://github.com/akhtar1985/zidan-select/issues"
  },
  "main": "zidan-form.js",
  "module": "zidan-form.mjs",
  "unpkg": "zidan-form.js",
  "jsdelivr": "zidan-form.js",
  "style": "plugin-theme.css",
  "exports": {
    ".": {
      "import": "./zidan-form.mjs",
      "require": "./zidan-form.js",
      "default": "./zidan-form.js"
    },
    "./select": {
      "import": "./dist/select/zidan-select.mjs",
      "require": "./dist/select/zidan-select.js",
      "default": "./dist/select/zidan-select.js"
    },
    "./select/css/core": "./dist/select/plugin-select-core.css",
    "./select/css/theme": "./dist/select/plugin-select-theme.css",
    "./file": {
      "import": "./dist/file/zidan-file.mjs",
      "require": "./dist/file/zidan-file.js",
      "default": "./dist/file/zidan-file.js"
    },
    "./file/css/core": "./dist/file/plugin-file-core.css",
    "./file/css/theme": "./dist/file/plugin-file-theme.css",
    "./css/core": "./plugin-core.css",
    "./css/theme": "./plugin-theme.css",
    "./core.css": "./plugin-core.css",
    "./theme.css": "./plugin-theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "zidan-form.js",
    "zidan-form.mjs",
    "plugin-core.css",
    "plugin-theme.css",
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "zidan-form.js",
    "zidan-form.mjs",
    "dist/**/*.css",
    "dist/**/*.js"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "lint": "node --check zidan-form.js && node --check demo.js && node --check playground.js && node --check zidan-form.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
